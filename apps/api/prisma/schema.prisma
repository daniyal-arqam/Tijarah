generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALESMAN
  COMPANY
  FACTORY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CredentialType {
  ID
  CR
  CERT
}

enum CredentialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadKind {
  HOT
  FOLLOW_UP
  NOT_INTERESTED
  CUSTOM
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentTerms {
  ADVANCE_50
  NET_15
  NET_30
  NET_45
  COD
}

enum OrderStatus {
  CONFIRMED
  SENT_TO_FACTORY
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  RECEIVED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
}

enum ProposalStatus {
  SENT
  OPENED
  SELECTED
  DECLINED
}

enum EstimateStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  DECLINED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  role          Role
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  phone         String?
  phoneVerified Boolean    @default(false)
  locale        String     @default("en")
  passwordResetHash    String?
  passwordResetExpires DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens RefreshToken[]
  salesman      SalesmanProfile?
  company       CompanyProfile?
  factory       FactoryProfile?
  credentials   Credential[]
  messages      Message[]
  notifications Notification[]
  reviewsAuthored Review[] @relation("ReviewAuthor")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)

  @@index([userId])
}

model FactoryProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName     String
  tradeName     String?
  city          String?
  crNumber      String?
  vatNumber     String?
  phone         String?
  address       String?
  about         String?
  specialties   String  @default("[]")
  capacityTons  Int     @default(0)
  logoUrl       String?
  verified      Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesmen  SalesmanProfile[]
  estimates FactoryEstimate[]
  orders    Order[]
  proposals Proposal[]
}

model SalesmanProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factoryId         String?
  factory           FactoryProfile? @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  displayName       String
  slug              String   @unique
  bio               String?
  photoUrl          String?
  title             String?
  languages         String   @default("[\"Arabic\",\"English\"]")
  certifications    String?
  coverageNotes     String?
  yearsExperience   Int      @default(0)
  cities            String   @default("[]")
  specialties       String   @default("[]")
  trustScore      Int      @default(4)
  waNumber        String?
  commissionPercent Float  @default(0)

  leadLists LeadList[]
  invites   Invite[]
  rfqs      Rfq[]
  quotes    Quote[]
  orders    Order[]
  reviews   Review[]
  proposals Proposal[]
  estimates FactoryEstimate[]
}

model CompanyProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName   String
  tradeName   String?
  industry    String?
  size        String?
  city        String?
  crNumber    String?
  vatNumber   String?
  contactName String?
  phone       String?
  logoUrl     String?

  leadItems LeadListItem[]
  invites   Invite[]
  rfqs      Rfq[]
  orders    Order[]
  proposals Proposal[]
}

model Credential {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       CredentialType
  fileUrl    String?
  note       String?
  status     CredentialStatus  @default(PENDING)
  reviewedBy String?
  createdAt  DateTime          @default(now())
}

model LeadList {
  id         String          @id @default(cuid())
  salesmanId String
  salesman   SalesmanProfile @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  kind       LeadKind
  name       String
  items      LeadListItem[]
}

model LeadListItem {
  id        String         @id @default(cuid())
  listId    String
  list      LeadList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([listId, companyId])
}

model Invite {
  id          String          @id @default(cuid())
  salesmanId  String
  salesman    SalesmanProfile @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  companyId   String?
  company     CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  email       String
  companyName String
  city        String?
  industry    String?
  token       String          @unique
  status      String          @default("PENDING")
  createdAt   DateTime        @default(now())
}

model Rfq {
  id               String           @id @default(cuid())
  companyId        String
  company          CompanyProfile   @relation(fields: [companyId], references: [id])
  salesmanId       String?
  salesman         SalesmanProfile? @relation(fields: [salesmanId], references: [id])
  title            String
  specialty        String
  specs            String
  quantity         Float
  unit             String           @default("pcs")
  destinationCity  String
  neededBy         DateTime?
  fileUrl          String?
  customize        Boolean          @default(false)
  status           String           @default("OPEN")
  createdAt        DateTime         @default(now())
  quotes           Quote[]
  messages         Message[]
  estimates        FactoryEstimate[]
  proposals        Proposal[]
}

model Quote {
  id                   String          @id @default(cuid())
  rfqId                String
  rfq                  Rfq             @relation(fields: [rfqId], references: [id])
  salesmanId           String
  salesman             SalesmanProfile @relation(fields: [salesmanId], references: [id])
  version              Int             @default(1)
  status               QuoteStatus     @default(DRAFT)
  paymentTerms         PaymentTerms    @default(NET_30)
  deliveryDate         DateTime?
  notes                String?
  factoryCostEstimate  Float           @default(0)
  discount             Float           @default(0)
  counterTotal         Float?
  counterDate          DateTime?
  createdAt            DateTime        @default(now())
  lines                QuoteLine[]
  order                Order?
}

model QuoteLine {
  id        String @id @default(cuid())
  quoteId   String
  quote     Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   String
  quantity  Float
  unitPrice Float
}

model Order {
  id            String          @id @default(cuid())
  quoteId       String          @unique
  quote         Quote           @relation(fields: [quoteId], references: [id])
  salesmanId    String
  salesman      SalesmanProfile @relation(fields: [salesmanId], references: [id])
  companyId     String
  company       CompanyProfile  @relation(fields: [companyId], references: [id])
  factoryId     String?
  factory       FactoryProfile? @relation(fields: [factoryId], references: [id])
  factoryCost   Float           @default(0)
  factoryPaidAt DateTime?
  status        OrderStatus     @default(CONFIRMED)
  promisedDate  DateTime?
  deliveredAt   DateTime?
  receivedAt    DateTime?
  createdAt     DateTime        @default(now())
  events        OrderEvent[]
  invoice       Invoice?
  reviews       Review[]
  messages      Message[]
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  photoUrls String      @default("[]")
  actorId   String
  createdAt DateTime    @default(now())
}

model Invoice {
  id        String        @id @default(cuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id])
  number    String        @unique
  subtotal  Float
  vat       Float
  total     Float
  dueDate   DateTime
  status    InvoiceStatus @default(UNPAID)
  createdAt DateTime      @default(now())
  payments  Payment[]
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  reference String?
}

model Review {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id])
  salesmanId       String
  salesman         SalesmanProfile @relation(fields: [salesmanId], references: [id])
  authorId         String
  author           User            @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorRole       Role            @default(COMPANY)
  quality          Int
  deliverySpeed    Int
  professionalism  Int
  body             String
  wouldOrderAgain  Boolean         @default(true)
  response         String?
  archived         Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@unique([orderId, authorId])
}

model Message {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  rfqId     String?
  rfq       Rfq?     @relation(fields: [rfqId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FactoryEstimate {
  id          String          @id @default(cuid())
  rfqId       String
  rfq         Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  factoryId   String
  factory     FactoryProfile  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  salesmanId  String
  salesman    SalesmanProfile @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  amount      Float?
  readyBy     DateTime?
  notes       String?
  status      EstimateStatus  @default(REQUESTED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  proposals   Proposal[]

  @@index([salesmanId, rfqId])
  @@index([factoryId, status])
}

model Proposal {
  id                 String          @id @default(cuid())
  salesmanId         String
  salesman           SalesmanProfile @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  companyId          String
  company            CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rfqId              String?
  rfq                Rfq?            @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  factoryId          String?
  factory            FactoryProfile? @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  factoryEstimateId  String?
  factoryEstimate    FactoryEstimate? @relation(fields: [factoryEstimateId], references: [id], onDelete: SetNull)
  subject            String
  body               String
  sellPrice          Float?
  factoryCost        Float?
  readyBy            DateTime?
  trackingToken      String          @unique
  status             ProposalStatus  @default(SENT)
  sentAt             DateTime        @default(now())
  openedAt           DateTime?
  followUpNotifiedAt DateTime?
  selectedAt         DateTime?
  createdAt          DateTime        @default(now())

  @@index([companyId, sentAt])
  @@index([salesmanId, sentAt])
  @@index([rfqId])
}
